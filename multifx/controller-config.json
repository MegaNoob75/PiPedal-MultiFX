    "bankTitleFontSize": "clamp(0.76rem, 1.6vw, 1.05rem)",
    "bankNameFontSize": "clamp(1.35rem, 4.2vw, 2.8rem)",
    "activePresetLabelFontSize": "clamp(0.72rem, 1.5vw, 0.95rem)",
    "activePresetNameFontSize": "clamp(0.95rem, 2.5vw, 1.55rem)",
